{
  "name": "megi-ucha-wedding-invitation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.dev.vars ./node_modules/vinext/dist/cli.js dev",
    "build": "vite build",
    "build:test": "NITRO_PRESET=node-server vite build",
    "start": "node --env-file-if-exists=.dev.vars .output/server/index.mjs",
    "test": "npm run build:test && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern .output --ignore-pattern .vercel --ignore-pattern .next"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "nitro": "^3.0.260610-beta",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "^1.0.0-beta.7",
    "vite": "^8.2.1"
  },
  "type": "module"
}
